{:paths ["src"]

 ;; JSON, base64, URL encoding and SHA-256 are portable Clojure in src/, so the
 ;; same sources read on every dialect (see hive-providers.platform). The two
 ;; dependencies are portable cljc too:
 ;;   hive-dsl  Results and closed ADTs (railway-oriented); result + adt
 ;;             namespaces only, which require nothing but clojure.set/string.
 ;;   malli     schemas for every boundary value (hive-providers.schema).
 ;; hive-system is PROVIDED scope: only hive-providers.host.hive-system needs
 ;; it, and a consumer that wants that adapter already has it (see README).
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.36"}
        metosin/malli {:mvn/version "0.20.2"}}

 :aliases
 {;; hive-system appears only here: provided scope for host.hive-system.
  :dev  {:extra-paths ["dev" "test"]
         :extra-deps  {io.github.hive-agi/hive-system {:mvn/version "0.3.14"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       io.github.hive-agi/hive-system {:mvn/version "0.3.14"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; ClojureScript on Node: clojure -M:cljs-test
  :cljs-test {:extra-paths ["test"]
              :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.42"}}
              :main-opts   ["-m" "cljs.main" "-re" "node" "-m" "hive-providers.test-runner"]}

  ;; Build + Clojars deploy: clojure -T:build jar | clojure -T:build deploy
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
          :ns-default hive-build.api}}}
