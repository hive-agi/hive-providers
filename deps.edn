{:paths ["src"]

 ;; Self-contained: the library itself depends on Clojure and nothing else.
 ;; JSON, base64, URL encoding and SHA-256 are portable Clojure in src/, so the
 ;; same sources read on every dialect (see hive-providers.platform).
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; ClojureScript on Node: clojure -M:cljs-test
  :cljs-test {:extra-paths ["test"]
              :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.42"}}
              :main-opts   ["-m" "cljs.main" "-re" "node" "-m" "hive-providers.test-runner"]}

  ;; Build + Clojars deploy: clojure -T:build jar | clojure -T:build deploy
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
          :ns-default hive-build.api}}}
